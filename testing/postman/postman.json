		{
			"name": "Movies – Reads",
			"item": [
				{
					"name": "GET /api/v1/movies – list with filters & pagination",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
									"const j = pm.response.json();",
									"",
									"// Normalize envelope to handle either backend shape",
									"const results =",
									"  (j.data && j.data.data) ||                // shape A: { data: { data: [], pagination: {} } }",
									"  (j.message && j.message.data) ||          // shape B: { message: { data: [], pagination: {} } }",
									"  [];",
									"",
									"const pagination =",
									"  (j.data && j.data.pagination) ||",
									"  (j.message && j.message.pagination) ||",
									"  null;",
									"",
									"pm.test(\"success flag present\", () => pm.expect(j).to.have.property(\"success\"));",
									"",
									"// Basic structure checks",
									"pm.test(\"has results array\", () => pm.expect(results).to.be.an(\"array\"));",
									"pm.test(\"has pagination object\", () => pm.expect(pagination).to.be.an(\"object\"));",
									"",
									"// Respects limit when results exist",
									"pm.test(\"respects limit when non-empty\", () => {",
									"  const q = pm.request.url.query.toObject();",
									"  const limit = Number(q.limit || 10);",
									"  pm.expect(results.length).to.be.at.most(limit);",
									"});",
									"",
									"// Save a movie id if present",
									"if (results.length > 0) {",
									"  const first = results[0];",
									"  const id = first.id || first.movie_id;",
									"  if (id) pm.environment.set(\"ANY_MOVIE_ID\", id);",
									"}",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
