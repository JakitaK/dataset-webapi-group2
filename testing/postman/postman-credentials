									"",
									"pm.environment.set(\"userToken\", j.data.accessToken);",
									"const uid = j.data?.user?.account_id ?? j.data?.user?.id ?? j.user?.account_id ?? j.user?.id;",
									"if (uid) pm.environment.set(\"userId\", uid);",
