{
  "name": "dataset-webapi-monorepo",
  "version": "1.0.0",
  "description": "Monorepo for Movies API and Credentials API - TCSS 460 (Group 2)",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "install:movies": "cd movies-api && npm install",
    "install:credentials": "cd credentials-api && npm install",
    "install:all": "npm run install:movies && npm run install:credentials",
    "dev:movies": "cd movies-api && npm run dev",
    "dev:credentials": "cd credentials-api && npm run dev",
    "start:movies": "cd movies-api && npm start",
    "start:credentials": "cd credentials-api && npm start"
  },
  "keywords": ["api", "monorepo", "movies", "credentials"],
  "author": "Group 2",
  "license": "ISC",
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
