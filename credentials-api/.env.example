# Credentials API Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3001
NODE_ENV=development

# Database
# Get this from Heroku Postgres or your local PostgreSQL instance
DATABASE_URL=postgresql://username:password@host:5432/database_name

# JWT Secret
# Generate a secure random string (use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_jwt_secret_here_change_this_in_production

# Application URLs
# Base URL for email verification links and password reset links
APP_BASE_URL=http://localhost:3001

# Email Service (Gmail with nodemailer)
# To enable real email sending:
# 1. Create a Gmail "burner" account for your group
# 2. Enable 2-Step Verification in Google Account settings (REQUIRED)
# 3. Generate an App Password: Security > App passwords > Mail > Other (Custom name)
# 4. Use the 16-character App Password below (NOT your regular Gmail password)
# Leave these commented out to use dev mode (logs emails to console/Heroku logs)
# EMAIL_USER=your-group-email@gmail.com
# EMAIL_APP_PASSWORD=your_16_character_app_password

# API Key (Optional - if you want to protect the entire API)
# API_KEY=your_api_key_here

